# Copiar a <FACTURADOR_HOME>/.env (default: ~/facturador/.env).
# Layout esperado en FACTURADOR_HOME (design.md §2.5):
#   .env  secrets/{homo,prod}.{crt,key}  data/  backups/

# Ambiente ARCA. Deriva URLs de WSAA/WSFEX y qué par cert/key se usa
# (secrets/<env>.crt + secrets/<env>.key). Único flag: no hay overrides.
ARCA_ENV=homo

# CUIT emisor (11 dígitos, sin guiones). Opcional: si falta, se extrae del
# subject del certificado en runtime.
#ARCA_CUIT=

# Passphrase de la clave privada, solo si la key la tiene.
#ARCA_KEY_PASSPHRASE=

# Punto de venta. En homologación es libre; en producción, el PV RECE
# exclusivo de exportación (design.md §1.4).
ARCA_PUNTO_VTA=1

# Puerto local (siempre en 127.0.0.1).
#FACTURADOR_PORT=8399

# Datos del emisor que van al PDF y no viajan a ARCA (design.md §0.1).
EMISOR_RAZON_SOCIAL=
EMISOR_DOMICILIO=
# Vacío => se imprime el CUIT.
EMISOR_IIBB=
# Texto libre, p.ej. 01/2020.
EMISOR_INICIO_ACTIVIDADES=

# Backups cifrados a S3 (facturador.backup). Sin bucket, el backup queda
# solo en <FACTURADOR_HOME>/backups/. La passphrase de age NUNCA va acá.
#BACKUP_S3_BUCKET=
#BACKUP_S3_PREFIX=facturador
